{
  "name": "flowstate",
  "version": "0.1.0",
  "description": "A journaling Electron app",
  "main": "./out/main/index.js",
  "author": "",
  "license": "MIT",
  "scripts": {
    "dev": "electron-vite dev",
    "build": "electron-vite build",
    "preview": "electron-vite preview",
    "test": "vitest",
    "typecheck": "tsc --build",
    "pretest": "node -e \"try{require('fs').rmSync('node_modules/better-sqlite3/build',{recursive:true,force:true})}catch(e){}\" && npm rebuild better-sqlite3",
    "predev": "node -e \"try{require('fs').rmSync('node_modules/better-sqlite3/build',{recursive:true,force:true})}catch(e){}\" && electron-builder install-app-deps",
    "prebuild": "node -e \"try{require('fs').rmSync('node_modules/better-sqlite3/build',{recursive:true,force:true})}catch(e){}\" && electron-builder install-app-deps",
    "publish": "npm run build && electron-builder --publish always"
  },
  "dependencies": {
    "@blocknote/core": "^0.53.0",
    "@blocknote/mantine": "^0.53.0",
    "@blocknote/react": "^0.53.0",
    "@mantine/core": "^8.3.18",
    "@mantine/hooks": "^8.3.18",
    "better-sqlite3": "^12.11.1",
    "electron-updater": "^6.8.9",
    "react": "^18.2.0",
    "react-dom": "^18.2.0",
    "recharts": "^3.10.1"
  },
  "devDependencies": {
    "@testing-library/jest-dom": "^6.1.0",
    "@testing-library/react": "^14.1.0",
    "@types/better-sqlite3": "^9.6.0",
    "@types/react": "^18.2.0",
    "@types/react-dom": "^18.2.0",
    "@vitejs/plugin-react": "^4.2.0",
    "electron": "^29.0.0",
    "electron-builder": "^25.0.0",
    "electron-vite": "^2.0.0",
    "jsdom": "^23.0.0",
    "typescript": "^5.2.0",
    "vite": "^5.0.0",
    "vitest": "^1.0.0"
  }
}
